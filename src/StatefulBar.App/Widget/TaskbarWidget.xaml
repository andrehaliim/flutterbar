<Window x:Class="StatefulBar.App.Widget.TaskbarWidget" x:ClassModifier="internal"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="FlutterBar"
        WindowStyle="None" AllowsTransparency="True" ShowInTaskbar="False" Topmost="True"
        ShowActivated="False" ResizeMode="NoResize" Width="300" Height="40"
        UseLayoutRounding="True" SnapsToDevicePixels="True"
        Background="Transparent" Foreground="{DynamicResource Fb.Foreground}"
        FontFamily="Segoe UI Variable Text, Segoe UI" FontSize="12">
    <!-- ShowInTaskbar/Owner must not be touched after creation: the owner is set to Shell_TrayWnd by TaskbarDocking.
         AllowsTransparency (layered window) so the background can be translucent: Backdrop below carries Fb.Background with
         the user's opacity (spec §7.6), the content above stays opaque. -->
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
        <FontFamily x:Key="Style.IconFont">Segoe Fluent Icons, Segoe MDL2 Assets</FontFamily>

        <Style x:Key="Style.IconButton" TargetType="Button">
            <Setter Property="Width" Value="24" />
            <Setter Property="Height" Value="24" />
            <Setter Property="Margin" Value="1,0" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="FontFamily" Value="{StaticResource Style.IconFont}" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="ToolTipService.ShowOnDisabled" Value="True" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="Transparent" CornerRadius="4">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Fb.Hover}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.35" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="Style.Chip" TargetType="Button">
            <Setter Property="Height" Value="26" />
            <Setter Property="Margin" Value="2,0" />
            <Setter Property="Padding" Value="8,0,6,0" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Foreground" Value="{DynamicResource Fb.Foreground}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{DynamicResource Fb.Chip}" CornerRadius="4" Padding="{TemplateBinding Padding}">
                            <ContentPresenter VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Fb.Hover}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Setter Property="ContentTemplate">
                <Setter.Value>
                    <DataTemplate>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{Binding}" MaxWidth="140" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                            <TextBlock Text="&#xE70D;" FontFamily="{StaticResource Style.IconFont}" FontSize="8" Margin="6,1,0,0"
                                       Foreground="{DynamicResource Fb.Muted}" VerticalAlignment="Center" />
                        </StackPanel>
                    </DataTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Config chip: red text when launch.json is invalid or the selected config is gone (spec §10). -->
        <Style x:Key="Style.ConfigChip" TargetType="Button" BasedOn="{StaticResource Style.Chip}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding ConfigHasError}" Value="True">
                    <Setter Property="Foreground" Value="{DynamicResource Fb.Red}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="Style.Separator" TargetType="Rectangle">
            <Setter Property="Width" Value="1" />
            <Setter Property="Height" Value="18" />
            <Setter Property="Margin" Value="4,0" />
            <Setter Property="Fill" Value="{DynamicResource Fb.Separator}" />
        </Style>

        <Style x:Key="Style.Dot" TargetType="Ellipse">
            <Setter Property="Width" Value="8" />
            <Setter Property="Height" Value="8" />
            <Setter Property="Margin" Value="2,0,6,0" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Fill" Value="{DynamicResource Fb.Grey}" />
        </Style>

        <!-- Flutter logo (monochrome, follows the button foreground) for the Flutter tools button in Full and Compact. -->
        <Style x:Key="Style.FlutterLogo" TargetType="Path">
            <Setter Property="Width" Value="13" />
            <Setter Property="Height" Value="13" />
            <Setter Property="Stretch" Value="Uniform" />
            <Setter Property="Fill" Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
            <Setter Property="Data" Value="M14.314,0 L2.3,12 L6,15.7 L21.684,0.013 Z M14.328,11.072 L7.857,17.53 L14.327,24 L21.7,24 L15.24,17.532 L21.7,11.072 Z" />
        </Style>

        <!-- Menu of the log button (Full and Compact): a click (left or right) asks "log or terminal" instead of opening the
             log at once. Same look as the widget menu (Menu/MenuStyles.xaml); tracked by TaskbarDocking like every ContextMenu. -->
        <ContextMenu x:Key="LogButtonMenu" Placement="Top" Style="{StaticResource Fb.ContextMenu}">
            <MenuItem Header="Open log" Click="OnLogMenuOpenLogClick">
                <MenuItem.Icon>
                    <TextBlock Text="&#xE756;" FontFamily="{StaticResource Fb.Menu.IconFont}" FontSize="16" />
                </MenuItem.Icon>
            </MenuItem>
            <MenuItem Header="Open terminal" Click="OnLogMenuOpenTerminalClick">
                <MenuItem.Icon>
                    <TextBlock Text="&#xE943;" FontFamily="{StaticResource Fb.Menu.IconFont}" FontSize="16" />
                </MenuItem.Icon>
            </MenuItem>
        </ContextMenu>

        <!-- ▶ / ⏳ / ⚡ / 🔄 / ⏹, shared by the three sizes; visibility and enabled state come from SessionControls -->
        <DataTemplate x:Key="SessionButtons">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <Button Style="{StaticResource Style.IconButton}" Command="{Binding RunCommand}" Content="&#xE768;"
                        Foreground="{DynamicResource Fb.Green}" ToolTip="Run" AutomationProperties.Name="Run"
                        Visibility="{Binding Controls.ShowRun, Converter={StaticResource BoolToVis}}" />
                <TextBlock Text="&#x23F3;" FontFamily="Segoe UI Symbol" FontSize="13" Width="24" TextAlignment="Center" VerticalAlignment="Center"
                           Foreground="{DynamicResource Fb.Yellow}" ToolTip="{Binding Controls.StatusText}"
                           Visibility="{Binding Controls.ShowProgress, Converter={StaticResource BoolToVis}}" />
                <Button Style="{StaticResource Style.IconButton}" Command="{Binding ReloadCommand}" Content="&#xE945;"
                        Foreground="{DynamicResource Fb.Yellow}" ToolTip="{Binding Controls.ReloadToolTip}" AutomationProperties.Name="Hot reload"
                        Visibility="{Binding Controls.ShowReload, Converter={StaticResource BoolToVis}}" />
                <Button Style="{StaticResource Style.IconButton}" Command="{Binding RestartCommand}" Content="&#xE72C;"
                        Foreground="{DynamicResource Fb.Green}" ToolTip="{Binding Controls.RestartToolTip}" AutomationProperties.Name="Hot restart"
                        Visibility="{Binding Controls.ShowRestart, Converter={StaticResource BoolToVis}}" />
                <Button Style="{StaticResource Style.IconButton}" Command="{Binding StopCommand}" Content="&#xE71A;"
                        Foreground="{DynamicResource Fb.Red}" ToolTip="Stop" AutomationProperties.Name="Stop"
                        Visibility="{Binding Controls.ShowStop, Converter={StaticResource BoolToVis}}" />
            </StackPanel>
        </DataTemplate>
    </Window.Resources>

    <!-- Right-click menu: Menu/WidgetContextMenu, assigned in code (Task 16). -->

    <Grid>
        <Border x:Name="Backdrop" Background="{DynamicResource Fb.Background}" Opacity="{Binding BackgroundOpacity}" />
        <Border x:Name="Frame" BorderThickness="1" BorderBrush="Transparent">
            <!-- All three sizes stay in the tree (Hidden, not Collapsed) so each can be measured for the size choice. -->
            <Grid x:Name="Root" ClipToBounds="True">
                <!-- Full: ● [project▾] [⎇ branch▾] [config▾] [device▾] | buttons | Flutter tools, log (console glyph) -->
                <DockPanel x:Name="FullPanel" Margin="6,0" LastChildFill="True">
                    <Ellipse x:Name="DotFull" DockPanel.Dock="Left" Style="{StaticResource Style.Dot}" ToolTip="{Binding StatusToolTip}" />
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                        <Rectangle Style="{StaticResource Style.Separator}" />
                        <ContentControl Content="{Binding}" ContentTemplate="{StaticResource SessionButtons}" Focusable="False" />
                        <Rectangle Style="{StaticResource Style.Separator}" />
                        <Button Style="{StaticResource Style.IconButton}" Command="{Binding FlutterToolsCommand}" ToolTip="{Binding FlutterToolTip}"
                                Foreground="{DynamicResource Fb.Foreground}" AutomationProperties.Name="Flutter tools">
                            <Path Style="{StaticResource Style.FlutterLogo}" />
                        </Button>
                        <Button Style="{StaticResource Style.IconButton}" Click="OnLogButtonClick" Content="&#xE756;"
                                Foreground="{DynamicResource Fb.Foreground}" ToolTip="Log and terminal" AutomationProperties.Name="Log and terminal"
                                ContextMenu="{StaticResource LogButtonMenu}" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" ClipToBounds="True">
                        <Button Style="{StaticResource Style.Chip}" Content="{Binding ProjectName}" Command="{Binding ProjectChipCommand}" ToolTip="Project"
                                AutomationProperties.Name="Project" />
                        <!-- Collapsed when the project is not a git repo (spec §5.5) -->
                        <Button Style="{StaticResource Style.Chip}" Command="{Binding BranchChipCommand}" ToolTip="{Binding BranchToolTip}" ContentTemplate="{x:Null}"
                                AutomationProperties.Name="Branch" Visibility="{Binding BranchVisible, Converter={StaticResource BoolToVis}}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#x2387;" FontFamily="Segoe UI Symbol" Margin="0,0,4,0" VerticalAlignment="Center" />
                                <TextBlock Text="{Binding Branch}" MaxWidth="140" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                <TextBlock Text="&#xE70D;" FontFamily="{StaticResource Style.IconFont}" FontSize="8" Margin="6,1,0,0"
                                           Foreground="{DynamicResource Fb.Muted}" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource Style.ConfigChip}" Content="{Binding ConfigName}" Command="{Binding ConfigChipCommand}"
                                ToolTip="{Binding ConfigToolTip}" ToolTipService.ShowOnDisabled="True" AutomationProperties.Name="Config" />
                        <Button Style="{StaticResource Style.Chip}" Content="{Binding DeviceName}" Command="{Binding DeviceChipCommand}" ToolTip="Device"
                                AutomationProperties.Name="Device" />
                    </StackPanel>
                </DockPanel>

                <!-- Compact: ● Configuration ▾ | buttons | Flutter tools, log (console glyph); the tooltip lists the current selection -->
                <DockPanel x:Name="CompactPanel" Margin="6,0" LastChildFill="True" Visibility="Hidden">
                    <Ellipse x:Name="DotCompact" DockPanel.Dock="Left" Style="{StaticResource Style.Dot}" ToolTip="{Binding StatusToolTip}" />
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                        <Rectangle Style="{StaticResource Style.Separator}" />
                        <ContentControl Content="{Binding}" ContentTemplate="{StaticResource SessionButtons}" Focusable="False" />
                        <Rectangle Style="{StaticResource Style.Separator}" />
                        <Button Style="{StaticResource Style.IconButton}" Command="{Binding FlutterToolsCommand}" ToolTip="{Binding FlutterToolTip}"
                                Foreground="{DynamicResource Fb.Foreground}" AutomationProperties.Name="Flutter tools">
                            <Path Style="{StaticResource Style.FlutterLogo}" />
                        </Button>
                        <Button Style="{StaticResource Style.IconButton}" Click="OnLogButtonClick" Content="&#xE756;"
                                Foreground="{DynamicResource Fb.Foreground}" ToolTip="Log and terminal" AutomationProperties.Name="Log and terminal"
                                ContextMenu="{StaticResource LogButtonMenu}" />
                    </StackPanel>
                    <Button Style="{StaticResource Style.Chip}" Command="{Binding CombinedChipCommand}" Content="Configuration"
                            HorizontalAlignment="Left" ToolTip="{Binding SelectionSummary}" AutomationProperties.Name="Configuration" />
                </DockPanel>

                <!-- ButtonsOnly: ● buttons (the dot opens the combined flyout, or the log when red) -->
                <StackPanel x:Name="ButtonsPanel" Orientation="Horizontal" Margin="4,0" VerticalAlignment="Center" Visibility="Hidden">
                    <Button Style="{StaticResource Style.IconButton}" Command="{Binding StatusDotCommand}" ToolTip="{Binding StatusToolTip}"
                            AutomationProperties.Name="Status">
                        <Ellipse x:Name="DotButtons" Style="{StaticResource Style.Dot}" Margin="0" />
                    </Button>
                    <ContentControl Content="{Binding}" ContentTemplate="{StaticResource SessionButtons}" Focusable="False" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
