<UserControl x:Class="StatefulBar.App.Widget.Toast" x:ClassModifier="internal"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FontFamily="Segoe UI Variable Text, Segoe UI" FontSize="12" Foreground="{DynamicResource Fb.Foreground}">
    <!-- Small notification above the widget (spec §3.3); hosted and timed by ToastHost. -->
    <Border CornerRadius="8" BorderThickness="1" Padding="10,8,8,8" MinWidth="220" MaxWidth="380"
            Background="{DynamicResource Fb.Background}" BorderBrush="{DynamicResource Fb.Separator}">
        <DockPanel>
            <Button x:Name="CloseButton" DockPanel.Dock="Right" VerticalAlignment="Top" Style="{StaticResource Fb.IconButton}"
                    Content="&#xE711;" ToolTip="Close" AutomationProperties.Name="Close notification" Click="OnCloseClick" />
            <StackPanel x:Name="Actions" DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0">
                <Button x:Name="PrimaryButton" Style="{StaticResource Fb.Button}" Click="OnPrimaryClick" />
                <Button x:Name="SecondaryButton" Style="{StaticResource Fb.Button}" Margin="0" Click="OnSecondaryClick" />
            </StackPanel>
            <TextBlock x:Name="MessageText" TextWrapping="Wrap" VerticalAlignment="Center" />
        </DockPanel>
    </Border>
</UserControl>
