<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <UseWPF>true</UseWPF>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <!-- Generated by tools\make-icon.ps1. Windows without their own Icon (log, dialogs) show the exe icon. -->
    <ApplicationIcon>Assets\flutterbar.ico</ApplicationIcon>
    <RootNamespace>StatefulBar.App</RootNamespace>
    <!-- StatefulBar.exe: the process name is matched by TaskbarLayoutAnalyzer.WidgetProcesses. -->
    <AssemblyName>StatefulBar</AssemblyName>
    <!-- Idle working set target < 100 MB (spec §1): no background GC thread for this small, mostly idle process. -->
    <ConcurrentGarbageCollection>false</ConcurrentGarbageCollection>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\StatefulBar.Core\StatefulBar.Core.csproj" />
    <!-- Copies sbar.exe (the CLI) next to StatefulBar.exe: "Tambahkan CLI ke PATH" adds this folder (Task 16). -->
    <ProjectReference Include="..\StatefulBar.Cli\StatefulBar.Cli.csproj" />
  </ItemGroup>

</Project>
