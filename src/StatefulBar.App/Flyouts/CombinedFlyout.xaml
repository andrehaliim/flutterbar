<UserControl x:Class="FlutterBar.App.Flyouts.CombinedFlyout" x:ClassModifier="internal"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Combined flyout for the Compact / ButtonsOnly sizes (spec §7.1): the four dropdowns as full-width rows (icon, label,
         whole value) so long names stay readable; the chosen one's flyout is shown below them, in the same popup. The branch
         row is collapsed outside git repos. -->
    <StackPanel>
        <ToggleButton x:Name="ProjectTab" Style="{StaticResource Fb.SectionRow}" Click="OnTabClick" AutomationProperties.Name="Project">
            <DockPanel>
                <TextBlock Style="{StaticResource Fb.SectionRowIcon}" Text="&#xE8B7;" />
                <TextBlock Style="{StaticResource Fb.SectionRowLabel}" Text="Project" />
                <TextBlock Style="{StaticResource Fb.SectionRowChevron}" DockPanel.Dock="Right" />
                <TextBlock x:Name="ProjectValue" Style="{StaticResource Fb.SectionRowValue}" />
            </DockPanel>
        </ToggleButton>
        <ToggleButton x:Name="BranchTab" Style="{StaticResource Fb.SectionRow}" Click="OnTabClick" AutomationProperties.Name="Branch">
            <DockPanel>
                <TextBlock Style="{StaticResource Fb.SectionRowIcon}" Text="⎇" FontFamily="Segoe UI Symbol, Segoe UI" />
                <TextBlock Style="{StaticResource Fb.SectionRowLabel}" Text="Branch" />
                <TextBlock Style="{StaticResource Fb.SectionRowChevron}" DockPanel.Dock="Right" />
                <TextBlock x:Name="BranchValue" Style="{StaticResource Fb.SectionRowValue}" />
            </DockPanel>
        </ToggleButton>
        <ToggleButton x:Name="ConfigTab" Style="{StaticResource Fb.SectionRow}" Click="OnTabClick" AutomationProperties.Name="Config">
            <DockPanel>
                <TextBlock Style="{StaticResource Fb.SectionRowIcon}" Text="&#xE713;" />
                <TextBlock Style="{StaticResource Fb.SectionRowLabel}" Text="Config" />
                <TextBlock Style="{StaticResource Fb.SectionRowChevron}" DockPanel.Dock="Right" />
                <TextBlock x:Name="ConfigValue" Style="{StaticResource Fb.SectionRowValue}" />
            </DockPanel>
        </ToggleButton>
        <ToggleButton x:Name="DeviceTab" Style="{StaticResource Fb.SectionRow}" Click="OnTabClick" AutomationProperties.Name="Device"
                      Margin="0">
            <DockPanel>
                <TextBlock Style="{StaticResource Fb.SectionRowIcon}" Text="&#xE8EA;" />
                <TextBlock Style="{StaticResource Fb.SectionRowLabel}" Text="Device" />
                <TextBlock Style="{StaticResource Fb.SectionRowChevron}" DockPanel.Dock="Right" />
                <TextBlock x:Name="DeviceValue" Style="{StaticResource Fb.SectionRowValue}" />
            </DockPanel>
        </ToggleButton>
        <Rectangle x:Name="SectionSeparator" Height="1" Margin="0,8" Fill="{DynamicResource Fb.Separator}" Visibility="Collapsed" />
        <ContentControl x:Name="Section" Focusable="False" Visibility="Collapsed" />
    </StackPanel>
</UserControl>
