<UserControl x:Class="FlutterBar.App.Flyouts.ProjectFlyout" x:ClassModifier="internal"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Project flyout (spec §5.1, §7.1): search, cached items first, unavailable items greyed out. -->
    <StackPanel>
        <TextBlock Text="Project" Style="{StaticResource Fb.FlyoutHeader}" />
        <TextBlock x:Name="Notice" Style="{StaticResource Fb.NoticeText}" Visibility="Collapsed" />
        <ProgressBar x:Name="Spinner" Style="{StaticResource Fb.Spinner}" Visibility="Collapsed" />
        <Grid>
            <TextBox x:Name="Search" Style="{StaticResource Fb.SearchBox}" AutomationProperties.Name="Search projects" />
            <TextBlock Text="Search projects…" IsHitTestVisible="False" Margin="9,5,0,0" Foreground="{DynamicResource Fb.Muted}">
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding Text, ElementName=Search}" Value="">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>
        </Grid>
        <ListBox x:Name="List" Style="{StaticResource Fb.FlyoutList}" AutomationProperties.Name="Project list" />
        <TextBlock x:Name="Empty" Style="{StaticResource Fb.MutedText}" Visibility="Collapsed" />
        <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
            <Button x:Name="AddButton" Style="{StaticResource Fb.Button}" Content="Add project…" Click="OnAddClick" />
        </StackPanel>
    </StackPanel>
</UserControl>
