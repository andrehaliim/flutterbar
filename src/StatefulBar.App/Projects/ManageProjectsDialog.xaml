<Window x:Class="FlutterBar.App.Projects.ManageProjectsDialog" x:ClassModifier="internal"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Manage projects" Width="600" Height="680" MinWidth="440" MinHeight="400"
        WindowStartupLocation="CenterScreen" ShowInTaskbar="True"
        Background="{DynamicResource Fb.Background}" Foreground="{DynamicResource Fb.Foreground}"
        FontFamily="Segoe UI Variable Text, Segoe UI" FontSize="12" UseLayoutRounding="True">
    <!-- Independent top-level window (never owned by the taskbar-owned widget). Changes apply and save immediately. -->
    <Window.Resources>
        <Style x:Key="Dialog.List" TargetType="ListBox" BasedOn="{StaticResource Fb.FlyoutList}">
            <Setter Property="MaxHeight" Value="150" />
            <Setter Property="MinHeight" Value="44" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="BorderBrush" Value="{DynamicResource Fb.Separator}" />
            <Setter Property="Margin" Value="0,0,0,6" />
        </Style>
        <Style x:Key="Dialog.Section" TargetType="TextBlock" BasedOn="{StaticResource Fb.FlyoutHeader}">
            <Setter Property="Margin" Value="2,14,0,2" />
        </Style>
    </Window.Resources>

    <DockPanel Margin="14">
        <StackPanel DockPanel.Dock="Bottom" Margin="0,10,0,0">
            <ProgressBar x:Name="Spinner" Style="{StaticResource Fb.Spinner}" Visibility="Collapsed" />
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <Button x:Name="RescanButton" Style="{StaticResource Fb.Button}" Content="Rescan" Click="OnRescanClick" />
                    <Button Style="{StaticResource Fb.Button}" Content="Close" IsCancel="True" Margin="0" Click="OnCloseClick" />
                </StackPanel>
                <TextBlock x:Name="StatusText" Style="{StaticResource Fb.MutedText}" VerticalAlignment="Center" />
            </DockPanel>
        </StackPanel>

        <ScrollViewer x:Name="Scroller" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel>
                <TextBlock x:Name="RootsHeader" Style="{StaticResource Fb.FlyoutHeader}" Text="Root folders" />
                <TextBlock Style="{StaticResource Fb.MutedText}" Text="Folders scanned (3 levels deep) for Flutter projects." />
                <ListBox x:Name="RootsList" Style="{StaticResource Dialog.List}" SelectionChanged="OnSelectionChanged" />
                <StackPanel Orientation="Horizontal">
                    <Button Style="{StaticResource Fb.Button}" Content="Add folder…" Click="OnAddRootClick" />
                    <Button x:Name="RemoveRootButton" Style="{StaticResource Fb.Button}" Content="Remove" IsEnabled="False" Click="OnRemoveRootClick" />
                </StackPanel>

                <TextBlock Style="{StaticResource Dialog.Section}" Text="Manual projects" />
                <TextBlock Style="{StaticResource Fb.MutedText}" Text="Projects outside the root folders." />
                <ListBox x:Name="ManualList" Style="{StaticResource Dialog.List}" SelectionChanged="OnSelectionChanged" />
                <StackPanel Orientation="Horizontal">
                    <Button Style="{StaticResource Fb.Button}" Content="Add project…" Click="OnAddManualClick" />
                    <Button x:Name="RemoveManualButton" Style="{StaticResource Fb.Button}" Content="Remove" IsEnabled="False" Click="OnRemoveManualClick" />
                </StackPanel>

                <TextBlock Style="{StaticResource Dialog.Section}" Text="Project list" />
                <TextBlock Style="{StaticResource Fb.MutedText}" Text="Projects shown in the project flyout. Hide the ones you don't use." />
                <ListBox x:Name="ProjectsList" Style="{StaticResource Dialog.List}" SelectionChanged="OnSelectionChanged" />
                <StackPanel Orientation="Horizontal">
                    <Button x:Name="HideButton" Style="{StaticResource Fb.Button}" Content="Hide" IsEnabled="False" Click="OnHideClick" />
                </StackPanel>

                <TextBlock x:Name="HiddenHeader" Style="{StaticResource Dialog.Section}" Text="Hidden projects" />
                <ListBox x:Name="HiddenList" Style="{StaticResource Dialog.List}" SelectionChanged="OnSelectionChanged" />
                <StackPanel Orientation="Horizontal">
                    <Button x:Name="UnhideButton" Style="{StaticResource Fb.Button}" Content="Show again" IsEnabled="False" Click="OnUnhideClick" />
                </StackPanel>
            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</Window>
