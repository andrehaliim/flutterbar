<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <UseWPF>true</UseWPF>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <!-- Generated by tools\make-icon.ps1. Windows without their own Icon (log, dialogs) show the exe icon. -->
    <ApplicationIcon>Assets\flutterbar.ico</ApplicationIcon>
    <RootNamespace>FlutterBar.App</RootNamespace>
    <!-- Idle working set target < 100 MB (spec §1): no background GC thread for this small, mostly idle process. -->
    <ConcurrentGarbageCollection>false</ConcurrentGarbageCollection>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\FlutterBar.Core\FlutterBar.Core.csproj" />
    <!-- Copies flutterbar.exe next to FlutterBar.App.exe: "Tambahkan CLI ke PATH" adds this folder (Task 16). -->
    <ProjectReference Include="..\FlutterBar.Cli\FlutterBar.Cli.csproj" />
  </ItemGroup>

</Project>
