<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <UseWPF>true</UseWPF>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <RootNamespace>FlutterBar.App</RootNamespace>
    <!-- Idle working set target < 100 MB (spec §1): no background GC thread for this small, mostly idle process. -->
    <ConcurrentGarbageCollection>false</ConcurrentGarbageCollection>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\FlutterBar.Core\FlutterBar.Core.csproj" />
    <!-- Copies flutterbar.exe next to FlutterBar.App.exe: "Tambahkan CLI ke PATH" adds this folder (Task 16). -->
    <ProjectReference Include="..\FlutterBar.Cli\FlutterBar.Cli.csproj" />
  </ItemGroup>

</Project>
