<UserControl x:Class="FlutterBar.App.Flyouts.ConfigFlyout" x:ClassModifier="internal"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Config flyout (spec §4.1, §10): launch.json is re-read on every open. -->
    <StackPanel>
        <TextBlock Text="Config" Style="{StaticResource Fb.FlyoutHeader}" />
        <ProgressBar x:Name="Spinner" Style="{StaticResource Fb.Spinner}" Visibility="Collapsed" />
        <StackPanel x:Name="MissingPanel" Visibility="Collapsed">
            <TextBlock Text="Belum ada config" Style="{StaticResource Fb.MutedText}" />
            <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                <Button x:Name="ImportButton" Style="{StaticResource Fb.Button}" Content="Import dari IDE" Click="OnImportClick" />
                <Button x:Name="DefaultButton" Style="{StaticResource Fb.Button}" Content="Buat default" Click="OnCreateDefaultClick" />
            </StackPanel>
        </StackPanel>
        <StackPanel x:Name="ErrorPanel" Visibility="Collapsed">
            <TextBlock Text="launch.json tidak valid:" Style="{StaticResource Fb.ErrorText}" FontWeight="SemiBold" />
            <ItemsControl x:Name="Errors">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding}" Style="{StaticResource Fb.ErrorText}" Margin="10,1,2,1" />
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>
        <ListBox x:Name="List" Style="{StaticResource Fb.FlyoutList}" AutomationProperties.Name="Daftar config" />
        <TextBlock x:Name="Message" Style="{StaticResource Fb.ErrorText}" Visibility="Collapsed" />
        <StackPanel x:Name="FileActions" Orientation="Horizontal" Margin="0,8,0,0" Visibility="Collapsed">
            <Button x:Name="OpenButton" Style="{StaticResource Fb.Button}" Content="Buka file" Click="OnOpenClick" />
        </StackPanel>
    </StackPanel>
</UserControl>
