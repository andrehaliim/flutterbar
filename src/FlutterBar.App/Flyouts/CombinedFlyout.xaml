<UserControl x:Class="FlutterBar.App.Flyouts.CombinedFlyout" x:ClassModifier="internal"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Combined flyout for the Compact / ButtonsOnly sizes (spec §7.1): the four dropdowns in one place. -->
    <StackPanel>
        <TextBlock Text="FlutterBar" Style="{StaticResource Fb.FlyoutHeader}" />
        <ListBox x:Name="List" Style="{StaticResource Fb.FlyoutList}" AutomationProperties.Name="Options" />
    </StackPanel>
</UserControl>
