<ContextMenu x:Class="FlutterBar.App.Menu.WidgetContextMenu" x:ClassModifier="internal"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Placement="Top">
    <!-- Right-click menu (spec §7.4). "Drag widget" / "Reset to auto position" are English on purpose (user decision).
         Opening/closing is tracked by TaskbarDocking (class handlers): topmost reassert suspended, menu HWND topmost. -->
    <MenuItem Header="Size">
        <MenuItem x:Name="SizeFull" Header="Full" Click="OnSizeClick" />
        <MenuItem x:Name="SizeCompact" Header="Compact" Click="OnSizeClick" />
        <MenuItem x:Name="SizeButtons" Header="Buttons only" Click="OnSizeClick" />
    </MenuItem>
    <MenuItem x:Name="DragItem" Header="Drag widget" IsCheckable="True" Click="OnDragClick" />
    <MenuItem Header="Reset to auto position" Click="OnResetClick" />
    <Separator />
    <MenuItem Header="Manage projects">
        <MenuItem Header="Root folders…" Click="OnScanRootsClick" />
        <MenuItem Header="Add project…" Click="OnAddProjectClick" />
        <MenuItem Header="Hidden projects…" Click="OnHiddenProjectsClick" />
        <Separator />
        <MenuItem Header="Rescan" Click="OnRescanClick" />
    </MenuItem>
    <MenuItem x:Name="ImportItem" Header="Import config from IDE…" Click="OnImportClick" />
    <MenuItem x:Name="LaunchJsonItem" Header="Open launch.json" Click="OnOpenLaunchJsonClick" />
    <MenuItem Header="Open log" Click="OnOpenLogClick" />
    <Separator />
    <MenuItem Header="Add CLI to PATH…" Click="OnAddToPathClick" />
    <MenuItem x:Name="StartupItem" Header="Start with Windows" IsCheckable="True" Click="OnStartupClick" />
    <Separator />
    <MenuItem Header="Exit" Click="OnExitClick" />
</ContextMenu>
