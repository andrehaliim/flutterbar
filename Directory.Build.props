<Project>
  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>
  <!-- Shown in the exe's Properties > Details and by the installers. Product version also carries the commit hash. -->
  <PropertyGroup>
    <Version>1.0.1</Version>
    <Authors>Andre Haliim</Authors>
    <Company>Andre Haliim Studio</Company>
    <Product>StatefulBar</Product>
    <Copyright>Copyright (c) 2026 Andre Haliim Studio</Copyright>
  </PropertyGroup>
</Project>
